# Kopiera till .env och justera vid behov. .env committas aldrig.

# --- apps/backend ---
PORT=4002
CORS_ORIGIN=http://localhost:5174

# Måste sättas i produktion. Utanför produktion faller backend tillbaka på
# samma lokala databas som docker/docker-compose.yml startar.
DATABASE_URL=postgres://coach_clock:coach_clock@localhost:5434/coach_clock

# --- docker/docker-compose.yml ---
# Lokala utvecklingsuppgifter. Byt dem om du exponerar porten utanför din maskin.
POSTGRES_USER=coach_clock
POSTGRES_PASSWORD=coach_clock
POSTGRES_DB=coach_clock

# --- apps/frontend ---
# Frontenden läser .env från repo-roten (envDir i vite.config.ts). Endast
# variabler med VITE_-prefix når webbläsaren — lägg aldrig hemligheter här.
# Inga variabler behövs ännu; backend-URL:en kommer med oRPC-klienten (#19).
