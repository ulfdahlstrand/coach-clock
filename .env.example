# Kopiera till .env och justera vid behov. .env committas aldrig.

# --- apps/backend ---
PORT=4002
CORS_ORIGIN=http://localhost:5174

# Måste sättas i produktion. Utanför produktion faller backend tillbaka på
# samma lokala databas som docker/docker-compose.yml startar.
DATABASE_URL=postgres://coach_clock:coach_clock@localhost:5434/coach_clock

# Tränarinloggningen (docs/tech-decisions.md, ADR-001). Alla tre krävs i
# produktion. Utan dem lokalt svarar "Logga in med Google" att inloggningen inte
# är tillgänglig — använd ENABLE_DEV_LOGIN i stället.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Måste stå som godkänd omdirigerings-URI i Google-klienten.
AUTH_CALLBACK_URL=http://localhost:4002/auth/google/callback
# Dit webbläsaren skickas efter inloggningen.
FRONTEND_URL=http://localhost:5174
# Secure-flaggan på sessionscookien. På som standard i produktion.
# COOKIE_SECURE=true
# Inloggning utan Google, bara utanför produktion. Kräver även
# VITE_ENABLE_DEV_LOGIN=true för att knappen ska synas.
ENABLE_DEV_LOGIN=false

# Integrationstesternas egen databas. Testerna droppar alla tabeller och vägrar
# därför köra utan den, eller mot utvecklingsdatabasen. Skapa den med
# `npm run docker:test-db`. Namnet måste innehålla "test".
TEST_DATABASE_URL=postgres://coach_clock:coach_clock@localhost:5434/coach_clock_test

# --- docker/docker-compose.yml ---
# Lokala utvecklingsuppgifter. Byt dem om du exponerar porten utanför din maskin.
POSTGRES_USER=coach_clock
POSTGRES_PASSWORD=coach_clock
POSTGRES_DB=coach_clock

# --- apps/frontend ---
# Frontenden läser .env från repo-roten (envDir i vite.config.ts). Endast
# variabler med VITE_-prefix når webbläsaren — lägg aldrig hemligheter här.

# Adressen till API:t sedd från webbläsaren. Absolut i utveckling, eller en
# sökväg som löses mot sidans origin. Driftsatt är den `/api`, som den statiska
# sajten skriver om till API-tjänsten (docs/deployment.md). Utelämnad faller
# frontenden tillbaka på http://localhost:4002.
VITE_API_URL=http://localhost:4002

# Visar "Logga in som dev-tränare" på inloggningssidan (se ENABLE_DEV_LOGIN).
VITE_ENABLE_DEV_LOGIN=false
